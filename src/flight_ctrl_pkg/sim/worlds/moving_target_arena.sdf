    <!-- 3B. 完整带四轮地面无人保障车 x2 (r1_rover 全套 STL 网格) -->
    <model name="parked_ugv_west">
      <static>true</static>
      <pose>2.5 10.2 0.069 0 0 -0.4</pose>
      <link name="link">
        <visual name="chassis"><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/chassis_link.STL</uri></mesh></geometry><material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.88 0.90 0.94 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/top_link.STL</uri></mesh></geometry><material><ambient>0.18 0.44 0.78 1</ambient><diffuse>0.24 0.54 0.90 1</diffuse></material></visual>
        <visual name="housing"><pose>0.0451 0 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/housing_link.STL</uri></mesh></geometry><material><ambient>0.16 0.18 0.22 1</ambient><diffuse>0.24 0.27 0.32 1</diffuse></material></visual>
        <visual name="battery"><pose>-0.1209 0 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/battery_link.STL</uri></mesh></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.22 1</diffuse></material></visual>
        <visual name="ant_l"><pose>-0.2035 0.0991 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/antenna_link.STL</uri></mesh></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.20 0.20 0.24 1</diffuse></material></visual>
        <visual name="ant_r"><pose>-0.2035 -0.0991 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/antenna_link.STL</uri></mesh></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.20 0.20 0.24 1</diffuse></material></visual>
        <visual name="wheel_lf"><pose>0.195 0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
        <visual name="wheel_lb"><pose>-0.195 0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
        <visual name="wheel_rf"><pose>0.195 -0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
        <visual name="wheel_rb"><pose>-0.195 -0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="parked_ugv_east">
      <static>true</static>
      <pose>34.5 6.8 0.069 0 0 2.75</pose>
      <link name="link">
        <visual name="chassis"><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/chassis_link.STL</uri></mesh></geometry><material><ambient>0.75 0.78 0.82 1</ambient><diffuse>0.88 0.90 0.94 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/top_link.STL</uri></mesh></geometry><material><ambient>0.82 0.56 0.14 1</ambient><diffuse>0.92 0.68 0.18 1</diffuse></material></visual>
        <visual name="housing"><pose>0.0451 0 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/housing_link.STL</uri></mesh></geometry><material><ambient>0.16 0.18 0.22 1</ambient><diffuse>0.24 0.27 0.32 1</diffuse></material></visual>
        <visual name="battery"><pose>-0.1209 0 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/battery_link.STL</uri></mesh></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.22 1</diffuse></material></visual>
        <visual name="ant_l"><pose>-0.2035 0.0991 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/antenna_link.STL</uri></mesh></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.20 0.20 0.24 1</diffuse></material></visual>
        <visual name="ant_r"><pose>-0.2035 -0.0991 0.1488 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/antenna_link.STL</uri></mesh></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.20 0.20 0.24 1</diffuse></material></visual>
        <visual name="wheel_lf"><pose>0.195 0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
        <visual name="wheel_lb"><pose>-0.195 0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
        <visual name="wheel_rf"><pose>0.195 -0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
        <visual name="wheel_rb"><pose>-0.195 -0.2121 0.0280 0 0 0</pose><geometry><mesh><scale>1.3 1.3 1.3</scale><uri>model://r1_rover/meshes/wheel_link.STL</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 4. 带持续旋转空域监视雷达的塔台 -->
    <model name="radar_control_tower">
      <pose>-4.5 14.5 0 0 0 0</pose>
      <link name="tower_base">
        <gravity>false</gravity>
        <inertial><mass>500</mass><inertia><ixx>100</ixx><iyy>100</iyy><izz>100</izz></inertia></inertial>
        <visual name="shaft">
          <pose>0 0 2.4 0 0 0</pose>
          <geometry><box><size>1.8 1.8 4.8</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_siding.png</albedo_map><roughness>0.65</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="glass_cabin">
          <pose>0 0 5.3 0 0 0</pose>
          <geometry><cylinder><radius>1.6</radius><length>1.1</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.36 0.62 1.0</ambient><diffuse>0.20 0.56 0.88 1.0</diffuse>
            <pbr><metal><roughness>0.12</roughness><metalness>0.85</metalness></metal></pbr>
          </material>
        </visual>
        <visual name="roof_cap">
          <pose>0 0 6.0 0 0 0</pose>
          <geometry><cylinder><radius>1.75</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.22 0.25 0.30 1</ambient><diffuse>0.35 0.38 0.44 1</diffuse></material>
        </visual>
      </link>
      <joint name="tower_fix" type="fixed"><parent>world</parent><child>tower_base</child></joint>
      <link name="radar_dish">
        <gravity>false</gravity>
        <pose>0 0 6.55 0 0 0</pose>
        <inertial><mass>2</mass><inertia><ixx>0.2</ixx><iyy>0.2</iyy><izz>0.2</izz></inertia></inertial>
        <visual name="dish_bar">
          <geometry><box><size>2.1 0.25 0.45</size></box></geometry>
          <material><ambient>0.82 0.84 0.88 1</ambient><diffuse>0.94 0.95 0.97 1</diffuse></material>
        </visual>
      </link>
      <joint name="radar_spin_joint" type="revolute">
        <parent>tower_base</parent><child>radar_dish</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>radar_spin_joint</joint_name>
        <initial_velocity>1.4</initial_velocity>
      </plugin>
    </model>

    <!-- 5. 空中红色高机动四旋翼靶机（z=5.5m 高空巡航，显著高于地面建筑，旋翼持续旋转） -->
    <include>
      <uri>model://red_target_uav</uri>
      <name>red_moving_target</name>
      <pose>6.8 0.5 5.5 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
