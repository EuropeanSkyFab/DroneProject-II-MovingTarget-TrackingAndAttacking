          <geometry><box><size>6.0 2.45 2.6</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/container_blue.png</albedo_map><roughness>0.55</roughness></metal></pbr>
          </material>
        </visual>

        <!-- 跑道边界助航灯标柱（含顶部发光灯帽） -->
        <visual name="pylon_nw"><pose>6.0 11.4 1.35 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>2.7</length></cylinder></geometry><material><ambient>0.16 0.50 0.88 1</ambient><diffuse>0.20 0.58 0.96 1</diffuse></material></visual>
        <visual name="pylon_nw_beacon"><pose>6.0 11.4 2.78 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.20 0.75 1.0 1</ambient><diffuse>0.30 0.85 1.0 1</diffuse><emissive>0.2 0.6 1.0 1</emissive></material></visual>
        <visual name="pylon_ne"><pose>20.0 11.4 1.35 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>2.7</length></cylinder></geometry><material><ambient>0.16 0.50 0.88 1</ambient><diffuse>0.20 0.58 0.96 1</diffuse></material></visual>
        <visual name="pylon_ne_beacon"><pose>20.0 11.4 2.78 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.20 0.75 1.0 1</ambient><diffuse>0.30 0.85 1.0 1</diffuse><emissive>0.2 0.6 1.0 1</emissive></material></visual>
        <visual name="pylon_sw"><pose>6.0 -5.4 1.35 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>2.7</length></cylinder></geometry><material><ambient>0.92 0.74 0.16 1</ambient><diffuse>0.96 0.80 0.22 1</diffuse></material></visual>
        <visual name="pylon_sw_beacon"><pose>6.0 -5.4 2.78 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>1.0 0.82 0.20 1</ambient><diffuse>1.0 0.88 0.25 1</diffuse><emissive>0.8 0.6 0.1 1</emissive></material></visual>
        <visual name="pylon_se"><pose>20.0 -5.4 1.35 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>2.7</length></cylinder></geometry><material><ambient>0.92 0.74 0.16 1</ambient><diffuse>0.96 0.80 0.22 1</diffuse></material></visual>
        <visual name="pylon_se_beacon"><pose>20.0 -5.4 2.78 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>1.0 0.82 0.20 1</ambient><diffuse>1.0 0.88 0.25 1</diffuse><emissive>0.8 0.6 0.1 1</emissive></material></visual>

