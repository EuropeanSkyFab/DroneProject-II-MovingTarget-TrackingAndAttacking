        <visual name="pine_c1a"><pose>4.0 -11.5 2.5 0 0 0</pose><geometry><cone><radius>1.65</radius><length>2.2</length></cone></geometry><material><ambient>0.12 0.30 0.12 1</ambient><diffuse>0.16 0.40 0.15 1</diffuse></material></visual>
        <visual name="pine_c1b"><pose>4.0 -11.5 3.6 0 0 0</pose><geometry><cone><radius>1.25</radius><length>1.9</length></cone></geometry><material><ambient>0.14 0.34 0.14 1</ambient><diffuse>0.19 0.45 0.18 1</diffuse></material></visual>
        <visual name="pine_c1c"><pose>4.0 -11.5 4.5 0 0 0</pose><geometry><cone><radius>0.82</radius><length>1.5</length></cone></geometry><material><ambient>0.16 0.38 0.15 1</ambient><diffuse>0.22 0.50 0.20 1</diffuse></material></visual>

        <visual name="pine_trunk_2"><pose>11.5 -12.0 1.1 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>2.2</length></cylinder></geometry><material><ambient>0.30 0.20 0.13 1</ambient><diffuse>0.38 0.26 0.17 1</diffuse></material></visual>
        <visual name="pine_c2a"><pose>11.5 -12.0 2.8 0 0 0</pose><geometry><cone><radius>1.85</radius><length>2.5</length></cone></geometry><material><ambient>0.11 0.28 0.12 1</ambient><diffuse>0.15 0.37 0.14 1</diffuse></material></visual>
        <visual name="pine_c2b"><pose>11.5 -12.0 4.0 0 0 0</pose><geometry><cone><radius>1.40</radius><length>2.1</length></cone></geometry><material><ambient>0.13 0.32 0.13 1</ambient><diffuse>0.18 0.42 0.17 1</diffuse></material></visual>
        <visual name="pine_c2c"><pose>11.5 -12.0 5.0 0 0 0</pose><geometry><cone><radius>0.90</radius><length>1.6</length></cone></geometry><material><ambient>0.16 0.37 0.15 1</ambient><diffuse>0.21 0.48 0.19 1</diffuse></material></visual>

        <visual name="pine_trunk_3"><pose>29.0 -11.0 1.2 0 0 0</pose><geometry><cylinder><radius>0.23</radius><length>2.4</length></cylinder></geometry><material><ambient>0.30 0.20 0.13 1</ambient><diffuse>0.38 0.26 0.17 1</diffuse></material></visual>
        <visual name="pine_c3a"><pose>29.0 -11.0 3.0 0 0 0</pose><geometry><cone><radius>1.95</radius><length>2.6</length></cone></geometry><material><ambient>0.12 0.31 0.13 1</ambient><diffuse>0.17 0.41 0.16 1</diffuse></material></visual>
