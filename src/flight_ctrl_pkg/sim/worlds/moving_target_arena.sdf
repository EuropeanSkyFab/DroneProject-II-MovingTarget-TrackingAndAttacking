<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="moving_target_arena">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::WindEffects" filename="gz-sim-wind-effects-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <wind>
      <linear_velocity>0.8 -0.4 0.0</linear_velocity>
    </wind>

    <scene>
      <grid>false</grid>
      <ambient>0.46 0.50 0.56 1</ambient>
      <background>0.58 0.76 0.94 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>10</speed>
        </clouds>
      </sky>
    </scene>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.85</intensity>
      <direction>0.42 0.36 -0.60</direction>
      <diffuse>1.00 0.94 0.84 1</diffuse>
      <specular>0.45 0.42 0.38 1</specular>
    </light>

    <!-- 1. 高清纹理化户外草坪试验场地面（无红色成分） -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material>
            <ambient>0.85 0.90 0.85 1</ambient>
            <diffuse>0.95 0.98 0.95 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://arena_assets/materials/textures/terrain_meadow.png</albedo_map>
                <roughness>0.92</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. 无人机综合试飞跑道 + 专属三机停机坪 H1(0,0) / H2(0,3) / H3(0,6) -->
    <model name="airfield_runway_and_pads">
      <static>true</static>
      <pose>0 0 0.004 0 0 0</pose>
      <link name="link">
        <visual name="main_runway">
          <pose>16.0 3.0 0.0 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>44.0 16.0 0.008</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/asphalt_runway.png</albedo_map><roughness>0.85</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="apron_pad_strip">
          <pose>-1.2 3.0 0.002 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>5.2 11.5 0.008</size></box></geometry>
          <material><ambient>0.26 0.29 0.34 1</ambient><diffuse>0.34 0.38 0.44 1</diffuse></material>
        </visual>
        <!-- H1 (0, 0) -->
        <visual name="helipad_h1">
          <pose>0.0 0.0 0.008 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2.2 2.2 0.006</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/helipad_h1.png</albedo_map><roughness>0.75</roughness></metal></pbr>
          </material>
        </visual>
        <!-- H2 (0, 3) -->
        <visual name="helipad_h2">
          <pose>0.0 3.0 0.008 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2.2 2.2 0.006</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/helipad_h2.png</albedo_map><roughness>0.75</roughness></metal></pbr>
          </material>
        </visual>
        <!-- H3 (0, 6) -->
        <visual name="helipad_h3">
          <pose>0.0 6.0 0.008 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2.2 2.2 0.006</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/helipad_h3.png</albedo_map><roughness>0.75</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. 试飞场建筑与外围自然地形丘陵（机库、集装箱、树林、山丘、航标、地面无人车） -->
    <model name="proving_ground_scenery">
      <static>true</static>
      <link name="link">
        <!-- 北侧主机库 + 太阳能屋顶 -->
        <visual name="hangar_1_body">
          <pose>22.0 16.0 2.1 0 0 0</pose>
          <geometry><box><size>9.0 5.5 4.2</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_siding.png</albedo_map><roughness>0.6</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="hangar_1_roof">
          <pose>22.0 16.0 4.35 0 0 0</pose>
          <geometry><box><size>9.4 6.0 0.35</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_roof.png</albedo_map><roughness>0.35</roughness><metalness>0.4</metalness></metal></pbr>
          </material>
        </visual>
        <visual name="hangar_1_bay_door">
          <pose>22.0 13.22 1.6 0 0 0</pose>
          <geometry><box><size>5.2 0.12 3.2</size></box></geometry>
          <material><ambient>0.14 0.18 0.22 1</ambient><diffuse>0.22 0.26 0.32 1</diffuse></material>
        </visual>

        <!-- 东侧维修机库 -->
        <visual name="hangar_2_body">
          <pose>41.0 2.0 1.9 0 0 1.570796</pose>
          <geometry><box><size>8.0 5.0 3.8</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_siding.png</albedo_map><roughness>0.6</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="hangar_2_roof">
          <pose>41.0 2.0 3.95 0 0 1.570796</pose>
          <geometry><box><size>8.4 5.4 0.35</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_roof.png</albedo_map><roughness>0.35</roughness><metalness>0.4</metalness></metal></pbr>
          </material>
        </visual>

        <!-- 货运集装箱组（蓝/黄高对比地标，无红色，显式设置 ambient/diffuse 确保 PBR 非黑） -->
        <visual name="container_1">
          <pose>11.0 15.5 1.3 0 0 0.15</pose>
          <geometry><box><size>6.0 2.45 2.6</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/container_blue.png</albedo_map><roughness>0.55</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="container_2">
          <pose>11.2 12.6 1.3 0 0 0.08</pose>
          <geometry><box><size>6.0 2.45 2.6</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse>
