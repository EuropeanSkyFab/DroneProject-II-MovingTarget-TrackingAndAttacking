          <pose>0 0 6.1 0 0 0</pose>
          <geometry><box><size>5.8 4.4 2.2</size></box></geometry>
          <material>
            <ambient>0.22 0.28 0.36 1</ambient><diffuse>0.30 0.38 0.48 1</diffuse>
            <pbr><metal><roughness>0.40</roughness><metalness>0.50</metalness></metal></pbr>
          </material>
        </visual>
        <visual name="radome">
          <pose>0 0 6.85 0 0 0</pose>
          <geometry><sphere><radius>0.62</radius></sphere></geometry>
          <material><ambient>0.82 0.86 0.92 1</ambient><diffuse>0.94 0.96 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3.10 obs_cooling_silo_s: cylinder cx=56.0, cy=-14.0, r=2.8, z=[0, 11.0] -->
    <model name="obs_cooling_silo_s">
      <static>true</static>
      <pose>56.0 -14.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 5.5 0 0 0</pose>
          <geometry><cylinder><radius>2.8</radius><length>11.0</length></cylinder></geometry>
        </collision>
        <visual name="shell">
          <pose>0 0 5.3 0 0 0</pose>
          <geometry><cylinder><radius>2.74</radius><length>10.6</length></cylinder></geometry>
          <material>
            <ambient>0.64 0.68 0.74 1</ambient><diffuse>0.78 0.82 0.88 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_siding.png</albedo_map><roughness>0.65</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="top_ring">
          <pose>0 0 10.78 0 0 0</pose>
          <geometry><cylinder><radius>2.78</radius><length>0.40</length></cylinder></geometry>
          <material><ambient>0.18 0.24 0.32 1</ambient><diffuse>0.26 0.34 0.44 1</diffuse></material>
        </visual>
        <visual name="thermal_vent">
          <pose>0 0 10.90 0 0 0</pose>
          <geometry><cylinder><radius>1.9</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.12 0.14 0.18 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>318.0</temperature>
          </plugin>
        </visual>
        <particle_emitter name="silo_steam" type="cylinder">
          <pose>0 0 11.05 0 0 0</pose>
          <emitting>true</emitting>
          <size>2.2 2.2 0.2</size>
          <particle_size>0.9 0.9 0.9</particle_size>
          <lifetime>3.0</lifetime>
          <rate>6</rate>
          <min_velocity>0.4</min_velocity>
          <max_velocity>1.1</max_velocity>
          <scale_rate>0.6</scale_rate>
          <color_start>0.88 0.92 0.96 0.35</color_start>
          <color_end>0.95 0.97 1.0 0.0</color_end>
        </particle_emitter>
      </link>
    </model>

    <!-- 3.11 obs_east_watchtower: cylinder cx=71.0, cy=6.5, r=1.8, z=[0, 14.5] -->
    <model name="obs_east_watchtower">
      <static>true</static>
      <pose>71.0 6.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 7.25 0 0 0</pose>
          <geometry><cylinder><radius>1.8</radius><length>14.5</length></cylinder></geometry>
        </collision>
        <visual name="column">
          <pose>0 0 6.0 0 0 0</pose>
          <geometry><cylinder><radius>1.28</radius><length>12.0</length></cylinder></geometry>
          <material><ambient>0.42 0.46 0.52 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material>
        </visual>
        <visual name="obs_pod">
          <pose>0 0 12.9 0 0 0</pose>
          <geometry><cylinder><radius>1.76</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.10 0.36 0.58 1</ambient><diffuse>0.16 0.52 0.84 1</diffuse>
            <pbr><metal><roughness>0.12</roughness><metalness>0.85</metalness></metal></pbr>
          </material>
        </visual>
        <visual name="roof_spire">
          <pose>0 0 14.12 0 0 0</pose>
          <geometry><cylinder><radius>1.4</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.04 0.55 0.85 1</ambient><diffuse>0.08 0.75 0.98 1</diffuse><emissive>0.02 0.30 0.48 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- 3.12 obs_east_warehouse: box cx=72.0, cy=-8.5, sx=8.0, sy=5.6, z=[0, 6.8] -->
    <model name="obs_east_warehouse">
      <static>true</static>
      <pose>72.0 -8.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 3.4 0 0 0</pose>
          <geometry><box><size>8.0 5.6 6.8</size></box></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><box><size>7.8 5.4 6.4</size></box></geometry>
          <material>
            <ambient>0.80 0.84 0.88 1</ambient><diffuse>0.92 0.95 0.98 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_siding.png</albedo_map><roughness>0.60</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="roof">
          <pose>0 0 6.6 0 0 0</pose>
          <geometry><box><size>7.96 5.56 0.36</size></box></geometry>
          <material>
            <ambient>0.85 0.88 0.92 1</ambient><diffuse>0.95 0.98 1.0 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_roof.png</albedo_map><roughness>0.34</roughness><metalness>0.42</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4. Visual-Only NFZ Ground Rings (cyan/ice-white, HSV red/amber safe, zero collision) -->
    <model name="nfz_ground_markers">
      <static>true</static>
      <link name="link">
        <visual name="nfz_radar_emitter_ring">
          <pose>-7.0 16.5 0.010 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>4.5</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.65 0.90 0.30</ambient>
            <diffuse>0.0 0.72 0.95 0.30</diffuse>
            <emissive>0.0 0.55 0.82 0.35</emissive>
          </material>
        </visual>
        <visual name="nfz_command_core_ring">
          <pose>58.0 15.5 0.010 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>6.0</radius><length>0.004</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.65 0.90 0.30</ambient>
            <diffuse>0.0 0.72 0.95 0.30</diffuse>
            <emissive>0.0 0.55 0.82 0.35</emissive>
