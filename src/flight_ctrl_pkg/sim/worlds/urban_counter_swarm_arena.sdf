    </model>
    <model name="strike_burst_3">
      <static>true</static>
      <pose>0 0 -5.0 0 0 0</pose>
      <link name="link">
        <particle_emitter name="burst" type="ellipsoid">
          <emitting>false</emitting>
          <duration>0.8</duration>
          <size>0.6 0.6 0.6</size>
          <particle_size>0.45 0.45 0.45</particle_size>
          <lifetime>1.2</lifetime>
          <rate>120</rate>
          <min_velocity>2.5</min_velocity>
          <max_velocity>7.0</max_velocity>
