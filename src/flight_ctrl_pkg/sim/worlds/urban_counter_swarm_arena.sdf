    <!-- 5. Pre-staged Intercept Strike Burst Particle Emitters (z=-5.0, emitting=false) -->
    <model name="strike_burst_1">
      <static>true</static>
      <pose>0 0 -5.0 0 0 0</pose>
      <link name="link">
        <particle_emitter name="burst" type="ellipsoid">
          <emitting>false</emitting>
          <duration>0.8</duration>
          <size>0.6 0.6 0.6</size>
          <particle_size>0.45 0.45 0.45</particle_size>
          <lifetime>1.2</lifetime>
          <rate>120</rate>
          <min_velocity>2.5</min_velocity>
          <max_velocity>7.0</max_velocity>
          <scale_rate>1.6</scale_rate>
          <color_start>1.0 0.72 0.20 1</color_start>
          <color_end>0.28 0.30 0.34 0.0</color_end>
          <topic>/fx/strike_burst_1/cmd</topic>
        </particle_emitter>
      </link>
    </model>
    <model name="strike_burst_2">
      <static>true</static>
      <pose>0 0 -5.0 0 0 0</pose>
      <link name="link">
        <particle_emitter name="burst" type="ellipsoid">
          <emitting>false</emitting>
          <duration>0.8</duration>
