    <!-- 3. 12 3D Obstacles (1-to-1 <collision> match to config/obstacles.yaml; zero red/amber hues) -->

    <!-- 3.1 obs_radar_tower: cylinder cx=-7.0, cy=16.5, r=2.0, z=[0, 15.0] -->
    <model name="obs_radar_tower">
      <pose>-7.0 16.5 0 0 0 0</pose>
      <link name="tower_base">
        <gravity>false</gravity>
        <inertial><mass>500</mass><inertia><ixx>100</ixx><iyy>100</iyy><izz>100</izz></inertia></inertial>
        <collision name="collision">
          <pose>0 0 7.5 0 0 0</pose>
          <geometry><cylinder><radius>2.0</radius><length>15.0</length></cylinder></geometry>
        </collision>
        <visual name="shaft">
          <pose>0 0 5.8 0 0 0</pose>
          <geometry><cylinder><radius>1.35</radius><length>11.6</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.78 0.84 1</ambient><diffuse>0.88 0.90 0.95 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/hangar_siding.png</albedo_map><roughness>0.65</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="glass_cabin">
          <pose>0 0 12.4 0 0 0</pose>
          <geometry><cylinder><radius>1.70</radius><length>1.6</length></cylinder></geometry>
          <material>
            <ambient>0.10 0.34 0.58 1</ambient><diffuse>0.18 0.52 0.84 1</diffuse>
            <pbr><metal><roughness>0.12</roughness><metalness>0.85</metalness></metal></pbr>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>314.0</temperature>
          </plugin>
        </visual>
        <visual name="roof_cap">
          <pose>0 0 13.4 0 0 0</pose>
          <geometry><cylinder><radius>1.85</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.22 0.25 0.30 1</ambient><diffuse>0.34 0.38 0.44 1</diffuse></material>
        </visual>
      </link>
      <joint name="tower_fix" type="fixed"><parent>world</parent><child>tower_base</child></joint>
      <link name="radar_dish">
        <gravity>false</gravity>
        <pose>0 0 14.35 0 0 0</pose>
        <inertial><mass>2.0</mass><inertia><ixx>0.2</ixx><iyy>0.2</iyy><izz>0.2</izz></inertia></inertial>
        <visual name="dish_bar">
          <geometry><box><size>3.2 0.28 0.55</size></box></geometry>
          <material>
            <ambient>0.80 0.84 0.88 1</ambient><diffuse>0.92 0.95 0.98 1</diffuse>
            <pbr><metal><roughness>0.28</roughness><metalness>0.70</metalness></metal></pbr>
          </material>
        </visual>
      </link>
      <joint name="radar_spin_joint" type="revolute">
        <parent>tower_base</parent><child>radar_dish</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>radar_spin_joint</joint_name>
        <initial_velocity>1.4</initial_velocity>
      </plugin>
    </model>

