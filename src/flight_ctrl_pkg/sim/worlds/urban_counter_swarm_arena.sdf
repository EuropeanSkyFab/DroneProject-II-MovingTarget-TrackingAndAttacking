<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="urban_counter_swarm_arena">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Core PX4 + Gazebo Harmonic Systems + Particle Emitter -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::WindEffects" filename="gz-sim-wind-effects-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::ParticleEmitter" filename="gz-sim-particle-emitter-system"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic">
      <temperature>293.15</temperature>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>
    <wind>
      <linear_velocity>0.6 -0.3 0.0</linear_velocity>
    </wind>

    <!-- Golden-Hour Cinematic Lighting, Dynamic Sky & Atmospheric Fog -->
    <scene>
      <grid>false</grid>
      <ambient>0.48 0.50 0.56 1</ambient>
      <background>0.52 0.68 0.88 1</background>
      <shadows>true</shadows>
      <sky>
        <time>17.8</time>
        <sunrise>6.0</sunrise>
        <sunset>19.0</sunset>
        <clouds>
          <speed>8.0</speed>
          <direction>0.4</direction>
          <humidity>0.42</humidity>
          <mean_size>0.45</mean_size>
          <ambient>0.92 0.82 0.72 1</ambient>
        </clouds>
      </sky>
      <fog>
        <color>0.82 0.78 0.72 1</color>
        <type>linear</type>
        <start>110.0</start>
        <end>480.0</end>
      </fog>
    </scene>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>2.4</intensity>
      <direction>0.68 0.42 -0.34</direction>
      <diffuse>1.00 0.86 0.68 1</diffuse>
      <specular>0.72 0.62 0.48 1</specular>
    </light>

    <!-- 1. Ground Plane & Tiled High-Res Turf Terrain (HSV red/amber safe) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="outer_meadow">
          <pose>40 0 -0.012 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>2400 2400</size></plane></geometry>
          <material>
            <ambient>0.78 0.84 0.78 1</ambient>
            <diffuse>0.88 0.92 0.88 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/terrain_meadow.png</albedo_map><roughness>0.95</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
        <!-- Crisp 16m x 16m tiled meadow grid across [-24..104] x [-40..40] -->
        <visual name="tile_m16_m32"><pose>-16 -32 0.0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>16 16</size></plane></geometry><material><ambient>0.85 0.90 0.85 1</ambient><diffuse>0.95 0.98 0.95 1</diffuse><pbr><metal><albedo_map>model://arena_assets/materials/textures/terrain_meadow.png</albedo_map><roughness>0.92</roughness></metal></pbr></material></visual>
        <visual name="tile_m16_m16"><pose>-16 -16 0.0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>16 16</size></plane></geometry><material><ambient>0.85 0.90 0.85 1</ambient><diffuse>0.95 0.98 0.95 1</diffuse><pbr><metal><albedo_map>model://arena_assets/materials/textures/terrain_meadow.png</albedo_map><roughness>0.92</roughness></metal></pbr></material></visual>
        <visual name="tile_m16_0"><pose>-16 0 0.0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>16 16</size></plane></geometry><material><ambient>0.85 0.90 0.85 1</ambient><diffuse>0.95 0.98 0.95 1</diffuse><pbr><metal><albedo_map>model://arena_assets/materials/textures/terrain_meadow.png</albedo_map><roughness>0.92</roughness></metal></pbr></material></visual>
        <visual name="tile_m16_16"><pose>-16 16 0.0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>16 16</size></plane></geometry><material><ambient>0.85 0.90 0.85 1</ambient><diffuse>0.95 0.98 0.95 1</diffuse><pbr><metal><albedo_map>model://arena_assets/materials/textures/terrain_meadow.png</albedo_map><roughness>0.92</roughness></metal></pbr></material></visual>
        <visual name="tile_m16_32"><pose>-16 32 0.0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>16 16</size></plane></geometry><material><ambient>0.85 0.90 0.85 1</ambient><diffuse>0.95 0.98 0.95 1</diffuse><pbr><metal><albedo_map>model://arena_assets/materials/textures/terrain_meadow.png</albedo_map><roughness>0.92</roughness></metal></pbr></material></visual>

