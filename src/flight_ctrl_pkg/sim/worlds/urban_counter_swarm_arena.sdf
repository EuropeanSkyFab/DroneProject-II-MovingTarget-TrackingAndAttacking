        <!-- Far-horizon perimeter hills strictly outside arena_bounds [-16..96] x [-34..34] -->
        <visual name="hill_north">
          <pose>42.0 72.0 -10.0 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><ellipsoid><radii>48.0 24.0 20.0</radii></ellipsoid></geometry>
          <material>
            <ambient>0.82 0.88 0.82 1</ambient><diffuse>0.92 0.96 0.92 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/terrain_hill.png</albedo_map><roughness>0.95</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="hill_south">
          <pose>40.0 -72.0 -10.0 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
