        </particle_emitter>
      </link>
    </model>

    <!-- 6. Cinema Director Camera Rig (always_on=false: zero Stage-1 headless cost) -->
    <model name="director_cam">
      <pose>-10.0 -8.0 5.5 0 0.12 0.35</pose>
      <static>false</static>
      <link name="cam_link">
        <gravity>false</gravity>
        <inertial><mass>0.01</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <sensor name="director_rgb" type="camera">
          <camera>
            <horizontal_fov>1.12</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>1200</far></clip>
          </camera>
          <always_on>false</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <plugin filename="gz-sim-lens-flare-system" name="gz::sim::systems::LensFlare">
            <light_name>sunUTC</light_name>
            <scale>0.65</scale>
            <color>1.0 0.78 0.45</color>
            <occlusion_steps>10</occlusion_steps>
          </plugin>
        </sensor>
        <sensor name="director_thermal" type="thermal">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>L8</format></image>
            <clip><near>0.1</near><far>800</far></clip>
          </camera>
          <always_on>false</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
            <min_temp>275.0</min_temp>
            <max_temp>430.0</max_temp>
            <resolution>0.5</resolution>
          </plugin>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <initial_linear>0.0 0.0 0.0</initial_linear>
        <initial_angular>0.0 0.0 0.0</initial_angular>
      </plugin>
    </model>

    <!-- 7. Pre-staged Hostile Target UAVs (outside interceptor corridor, driven via VelocityControl) -->
    <include>
      <uri>model://red_target_uav</uri>
      <name>red_moving_target</name>
      <pose>20.5 2.5 5.7 0 0 0</pose>
    </include>
    <include>
      <uri>model://amber_target_uav</uri>
      <name>amber_escort_target</name>
      <pose>42.0 -1.5 7.2 0 0 0</pose>
    </include>
    <include>
      <uri>model://slate_target_uav</uri>
      <name>slate_recon_target</name>
      <pose>64.0 3.0 8.5 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
