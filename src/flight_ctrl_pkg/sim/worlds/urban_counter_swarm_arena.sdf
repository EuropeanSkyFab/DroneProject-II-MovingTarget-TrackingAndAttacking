      </link>
    </model>

    <!-- 2. Airfield Runway, Squadron Apron & 8 Helipads (H1..H8 matching obstacles.yaml) -->
    <model name="airfield_runway_and_pads">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="runway_seg_1">
          <pose>16.5 1.5 0.004 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>30.0 16.0 0.008</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse>
            <pbr><metal><albedo_map>model://arena_assets/materials/textures/asphalt_runway.png</albedo_map><roughness>0.84</roughness></metal></pbr>
          </material>
        </visual>
