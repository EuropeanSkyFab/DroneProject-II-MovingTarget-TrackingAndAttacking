<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="amber_target_uav">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Heavy tactical amber/gold quadrotor escort (1.24x x500_base, H_cv in [14..19]) -->
    <link name="target_link">
      <gravity>false</gravity>
      <inertial>
        <mass>2.6</mass>
        <inertia>
          <ixx>0.045</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.045</iyy><iyz>0</iyz>
          <izz>0.080</izz>
        </inertia>
      </inertial>
      <collision name="fuselage_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.55 0.55 0.20</size></box></geometry>
      </collision>

      <visual name="airframe_core">
        <pose>0 0 0.031 0 0 3.141592654</pose>
        <geometry>
          <mesh>
            <scale>1.24 1.24 1.24</scale>
            <uri>model://x500_base/meshes/NXP-HGD-CF.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.18 0.16 0.12 1</ambient>
          <diffuse>0.26 0.24 0.18 1</diffuse>
        </material>
      </visual>

      <visual name="amber_canopy">
        <pose>0 0 0.082 0 0 0</pose>
        <geometry><box><size>0.26 0.18 0.068</size></box></geometry>
        <material>
          <ambient>0.72 0.31 0.005 1</ambient>
          <diffuse>0.76 0.35 0.005 1</diffuse>
          <emissive>0.92 0.16 0.00 1</emissive>
          <pbr><metal><roughness>0.30</roughness><metalness>0.45</metalness></metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>340.0</temperature>
        </plugin>
      </visual>

      <visual name="amber_arm_fl">
        <pose>0.108 0.108 0.038 0 0 0.785398</pose>
        <geometry><box><size>0.24 0.036 0.022</size></box></geometry>
        <material><ambient>0.72 0.31 0.005 1</ambient><diffuse>0.76 0.35 0.005 1</diffuse><emissive>0.92 0.16 0.00 1</emissive><pbr><metal><roughness>0.30</roughness><metalness>0.45</metalness></metal></pbr></material>
      </visual>
      <visual name="amber_arm_fr">
        <pose>0.108 -0.108 0.038 0 0 -0.785398</pose>
        <geometry><box><size>0.24 0.036 0.022</size></box></geometry>
        <material><ambient>0.72 0.31 0.005 1</ambient><diffuse>0.76 0.35 0.005 1</diffuse><emissive>0.92 0.16 0.00 1</emissive><pbr><metal><roughness>0.30</roughness><metalness>0.45</metalness></metal></pbr></material>
      </visual>
      <visual name="amber_arm_rl">
        <pose>-0.108 0.108 0.038 0 0 -0.785398</pose>
        <geometry><box><size>0.24 0.036 0.022</size></box></geometry>
        <material><ambient>0.72 0.31 0.005 1</ambient><diffuse>0.76 0.35 0.005 1</diffuse><emissive>0.92 0.16 0.00 1</emissive><pbr><metal><roughness>0.30</roughness><metalness>0.45</metalness></metal></pbr></material>
      </visual>
      <visual name="amber_arm_rr">
        <pose>-0.108 -0.108 0.038 0 0 0.785398</pose>
        <geometry><box><size>0.24 0.036 0.022</size></box></geometry>
        <material><ambient>0.72 0.31 0.005 1</ambient><diffuse>0.76 0.35 0.005 1</diffuse><emissive>0.92 0.16 0.00 1</emissive><pbr><metal><roughness>0.30</roughness><metalness>0.45</metalness></metal></pbr></material>
      </visual>

      <visual name="motor_pod_0">
        <pose>0.2158 0.2158 0.040 0 0 -0.45</pose>
        <geometry><mesh><scale>1.24 1.24 1.24</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>360.0</temperature></plugin>
      </visual>
      <visual name="motor_pod_1">
        <pose>-0.2158 0.2158 0.040 0 0 -0.45</pose>
        <geometry><mesh><scale>1.24 1.24 1.24</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>360.0</temperature></plugin>
      </visual>
      <visual name="motor_pod_2">
        <pose>0.2158 -0.2158 0.040 0 0 -0.45</pose>
        <geometry><mesh><scale>1.24 1.24 1.24</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>360.0</temperature></plugin>
      </visual>
      <visual name="motor_pod_3">
        <pose>-0.2158 -0.2158 0.040 0 0 -0.45</pose>
        <geometry><mesh><scale>1.24 1.24 1.24</scale><uri>model://x500_base/meshes/5010Base.dae</uri></mesh></geometry>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>360.0</temperature></plugin>
      </visual>

      <!-- High-contrast amber nav strobes -->
      <visual name="strobe_0">
        <pose>0.2158 0.2158 0.015 0 0 0</pose>
        <geometry><sphere><radius>0.020</radius></sphere></geometry>
        <material><ambient>0.80 0.35 0.005 1</ambient><diffuse>0.85 0.39 0.005 1</diffuse><emissive>0.95 0.18 0.00 1</emissive><pbr><metal><roughness>0.25</roughness><metalness>0.45</metalness></metal></pbr></material>
      </visual>
      <visual name="strobe_1">
        <pose>-0.2158 -0.2158 0.015 0 0 0</pose>
        <geometry><sphere><radius>0.020</radius></sphere></geometry>
        <material><ambient>0.80 0.35 0.005 1</ambient><diffuse>0.85 0.39 0.005 1</diffuse><emissive>0.95 0.18 0.00 1</emissive><pbr><metal><roughness>0.25</roughness><metalness>0.45</metalness></metal></pbr></material>
      </visual>

      <particle_emitter name="kill_burst" type="box">
        <emitting>false</emitting>
        <duration>0.8</duration>
        <size>0.4 0.4 0.4</size>
        <particle_size>0.35 0.35 0.35</particle_size>
        <lifetime>1.1</lifetime>
        <rate>120</rate>
        <min_velocity>2.0</min_velocity>
        <max_velocity>6.5</max_velocity>
        <scale_rate>1.4</scale_rate>
        <color_start>1.0 0.72 0.15 1</color_start>
        <color_end>0.25 0.27 0.30 0.0</color_end>
      </particle_emitter>
    </link>

    <link name="rotor_0">
      <gravity>false</gravity>
      <pose>0.2158 -0.2158 0.074 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>1.04 1.04 1.04</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.28 0.28 0.32 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>target_link</parent><child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_1">
      <gravity>false</gravity>
      <pose>-0.2158 0.2158 0.074 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>1.04 1.04 1.04</scale><uri>model://x500_base/meshes/1345_prop_ccw.stl</uri></mesh></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.28 0.28 0.32 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>target_link</parent><child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_2">
      <gravity>false</gravity>
      <pose>0.2158 0.2158 0.074 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>1.04 1.04 1.04</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.28 0.28 0.32 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>target_link</parent><child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_3">
      <gravity>false</gravity>
      <pose>-0.2158 -0.2158 0.074 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>1.04 1.04 1.04</scale><uri>model://x500_base/meshes/1345_prop_cw.stl</uri></mesh></geometry>
        <material><ambient>0.18 0.18 0.20 1</ambient><diffuse>0.28 0.28 0.32 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>target_link</parent><child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_0_joint</joint_name><initial_velocity>58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_1_joint</joint_name><initial_velocity>58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_2_joint</joint_name><initial_velocity>-58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_3_joint</joint_name><initial_velocity>-58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <initial_linear>0.0 0.0 0.0</initial_linear>
      <initial_angular>0.0 0.0 0.0</initial_angular>
    </plugin>
  </model>
</sdf>
