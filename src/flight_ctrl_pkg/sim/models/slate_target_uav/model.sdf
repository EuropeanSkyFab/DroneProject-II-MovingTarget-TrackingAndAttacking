<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="slate_target_uav">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Stealth dark-slate recon quadrotor with electric-violet canopy/strobes (H_cv in [135..158]) -->
    <link name="target_link">
      <gravity>false</gravity>
      <inertial>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.035</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.035</iyy><iyz>0</iyz>
          <izz>0.060</izz>
        </inertia>
      </inertial>
      <collision name="fuselage_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.46 0.46 0.18</size></box></geometry>
      </collision>

      <visual name="slate_airframe">
        <pose>0 0 0 1.5707 0 0.01</pose>
        <geometry>
          <mesh>
            <scale>0.0015 0.0015 0.0015</scale>
            <uri>model://px4vision/meshes/body.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.18 0.22 0.28 1</ambient>
          <diffuse>0.24 0.28 0.36 1</diffuse>
          <pbr><metal><roughness>0.42</roughness><metalness>0.35</metalness></metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>335.0</temperature>
        </plugin>
      </visual>

      <visual name="violet_dorsal_canopy">
        <pose>0 0 0.055 0 0 0</pose>
        <geometry><box><size>0.22 0.15 0.048</size></box></geometry>
        <material>
          <ambient>0.68 0.14 0.96 1</ambient>
          <diffuse>0.78 0.18 1.0 1</diffuse>
          <emissive>0.35 0.05 0.55 1</emissive>
          <pbr><metal><roughness>0.25</roughness><metalness>0.20</metalness></metal></pbr>
        </material>
      </visual>

      <visual name="rear_power_pack">
        <pose>-0.11 0 0.015 0 0 0</pose>
        <geometry><box><size>0.09 0.10 0.055</size></box></geometry>
        <material><ambient>0.16 0.18 0.24 1</ambient><diffuse>0.22 0.24 0.30 1</diffuse></material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>358.0</temperature>
        </plugin>
      </visual>

      <visual name="violet_strobe_fl">
        <pose>0.14025 0.1605 0.025 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.68 0.14 0.96 1</ambient><diffuse>0.78 0.18 1.0 1</diffuse><emissive>0.55 0.08 0.85 1</emissive></material>
      </visual>
      <visual name="violet_strobe_rr">
        <pose>-0.14025 -0.1605 0.025 0 0 0</pose>
        <geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.68 0.14 0.96 1</ambient><diffuse>0.78 0.18 1.0 1</diffuse><emissive>0.55 0.08 0.85 1</emissive></material>
      </visual>

      <particle_emitter name="kill_burst" type="box">
        <emitting>false</emitting>
        <duration>0.8</duration>
        <size>0.4 0.4 0.4</size>
        <particle_size>0.35 0.35 0.35</particle_size>
        <lifetime>1.1</lifetime>
        <rate>120</rate>
        <min_velocity>2.0</min_velocity>
        <max_velocity>6.5</max_velocity>
        <scale_rate>1.4</scale_rate>
        <color_start>0.85 0.45 1.0 1</color_start>
        <color_end>0.25 0.27 0.30 0.0</color_end>
      </particle_emitter>
    </link>

    <link name="rotor_0">
      <gravity>false</gravity>
      <pose>0.14025 -0.1605 0.045 0 0 0</pose>
      <inertial><mass>0.008</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>0.90 0.90 0.90</scale><uri>model://px4vision/meshes/iris_prop_ccw.dae</uri></mesh></geometry>
        <material><ambient>0.68 0.14 0.96 1</ambient><diffuse>0.78 0.18 1.0 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>target_link</parent><child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_1">
      <gravity>false</gravity>
      <pose>-0.14025 0.1605 0.045 0 0 0</pose>
      <inertial><mass>0.008</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>0.90 0.90 0.90</scale><uri>model://px4vision/meshes/iris_prop_ccw.dae</uri></mesh></geometry>
        <material><ambient>0.68 0.14 0.96 1</ambient><diffuse>0.78 0.18 1.0 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>target_link</parent><child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_2">
      <gravity>false</gravity>
      <pose>0.14025 0.1605 0.045 0 0 0</pose>
      <inertial><mass>0.008</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>0.90 0.90 0.90</scale><uri>model://px4vision/meshes/iris_prop_cw.dae</uri></mesh></geometry>
        <material><ambient>0.18 0.22 0.28 1</ambient><diffuse>0.26 0.30 0.38 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>target_link</parent><child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_3">
      <gravity>false</gravity>
      <pose>-0.14025 -0.1605 0.045 0 0 0</pose>
      <inertial><mass>0.008</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="prop">
        <geometry><mesh><scale>0.90 0.90 0.90</scale><uri>model://px4vision/meshes/iris_prop_cw.dae</uri></mesh></geometry>
        <material><ambient>0.18 0.22 0.28 1</ambient><diffuse>0.26 0.30 0.38 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>target_link</parent><child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_0_joint</joint_name><initial_velocity>58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_1_joint</joint_name><initial_velocity>58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_2_joint</joint_name><initial_velocity>-58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_3_joint</joint_name><initial_velocity>-58.0</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <initial_linear>0.0 0.0 0.0</initial_linear>
      <initial_angular>0.0 0.0 0.0</initial_angular>
    </plugin>
  </model>
</sdf>
